{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate manages GitHub Actions docker:// image updates. Regular owner/repo@sha actions are handled by Dependabot.",
  "extends": ["config:recommended"],
  "enabledManagers": ["github-actions"],
  "schedule": ["on monday"],
  "labels": ["dependencies", "ci"],
  "assignees": ["Stensel8"],
  "commitMessagePrefix": "deps:",
  "packageRules": [
    {
      "description": "Auto-merge patch and digest updates that pass CI.",
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group all Docker-based action image updates into one PR.",
      "matchManagers": ["github-actions"],
      "matchDatasources": ["docker"],
      "groupName": "Docker action images",
      "labels": ["dependencies", "ci"]
    }
  ]
}
